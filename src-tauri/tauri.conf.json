{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitrove",
  "version": "0.3.0",
  "identifier": "dev.gitrove.app",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "python3 -m http.server 5173 --directory ui",
      "wait": false
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "gitrove",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0f1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "A git-style commit graph for work that isn't code"
  }
}
